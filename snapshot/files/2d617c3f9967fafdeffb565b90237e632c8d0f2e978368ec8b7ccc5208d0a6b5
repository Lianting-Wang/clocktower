*{
    margin: 0;
    padding: 0;
    
}
html,body{
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.content{
    width: 100%;
    height: 100%;
    overflow: scroll;
}
.content .stroller{
    width: 100%;
    height: auto;
}

.content_pc{
    width: 50%;
    height: 155px;
    display: flex;
    align-items: center;
    position: absolute;
    top: 0;
    left: 25%;
}
#pcbutton1{
    width: 50%;
    height: 100%;
}
#pcbutton2{
    width: 50%;
    height: 100%;
}

.content_html{
    width: 100%;
    height: 125px;
    display: flex;
    align-items: center;
    position: absolute;
    top: 0;
    left: 0;
}
#button1{
    width: 50%;
    height: 100%;
}
#button2{
    width: 50%;
    height: 100%;
}



<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta name="description" content="为您提供钟楼谜团游戏相关资讯信息、角色介绍、规则说明以及线上体验等。">
        <meta name="keywords" content="染钟楼谜团,钟楼谜团百科,钟楼谜团角色大全,钟楼谜团线上版">
        <title>染钟楼谜团官网_钟楼谜团百科_钟楼谜团线上版</title>
        <link rel="stylesheet" href="./index.css">
        <link rel="apple-touch-icon" sizes="180x180" href="./images/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="./images/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="./images/favicon-16x16.png">
        <link rel="manifest" href="./images/site.webmanifest">
        <meta name="msapplication-TileColor" content="#da532c">
        <meta name="theme-color" content="#ffffff">
    </head>
    <body>
        <!-- 腾讯会议H5版 -->
        <div class="content" id="button">
            <div class="content_html" id="content_html">
                <div id="button1"></div>
                <div id="button2"></div>
             </div>
            <img class="stroller" id="picts" style="width: 100%;" src="./images/stroller_h5.png" alt="">
        </div>
        <!-- 腾讯会议网页版 -->
        <div class="content" id="pcbutton">
            <div class="content_pc" id="content_pc">
               <div id="pcbutton1"></div>
               <div id="pcbutton2"></div>
            </div>
            <img class="stroller" id="pc_picts" style="width: 100%;" src="./images/stroller_pc.png" alt="">
        </div>

        <div class="content" id="mdbutton">
            <div class="content_pc_md" id="content_pc_md">
               <div id="mdbutton1"></div>
               <div id="mdbutton2"></div>
            </div>
            <img class="stroller" id="md_picts" style="width: 100%;" src="./images/stroller_md.png" alt="">
        </div>

    </body>
</html>

<script type="text/javascript">
    // 百度统计
    var _hmt = _hmt || [];
    (function() {
    var hm = document.createElement("script");
    hm.src = "https://hm.baidu.com/hm.js?044476704c798f973646045e948828a6";
    var s = document.getElementsByTagName("script")[0]; 
    s.parentNode.insertBefore(hm, s);
    })();

    function GetQueryString(name){
        var reg = new RegExp("(^|&)"+ name +"=([^&]*)(&|$)");
        var r = window.location.search.substr(1).match(reg);
        if(r!=null)return  unescape(r[2]); return null;
    }
    console.log(GetQueryString("type"))
    console.log(GetQueryString("bIsWM"))
    var type = GetQueryString("type") || 0
    var bIsWM = GetQueryString("bIsWM") || ""
    // 腾讯会议
    var button = document.getElementById("button");
    var pcbutton = document.getElementById("pcbutton");
    var content_html = document.getElementById("content_html");
    var content_pc = document.getElementById("content_pc");
    //魔典
    var mdbutton = document.getElementById("mdbutton");
    var content_pc_md = document.getElementById("content_pc_md");
    
    // type:1为腾讯会议  2为魔典
    if(type == 1 && bIsWM == 'android' || type == 1 && bIsWM == 'ios'){
        button.style.display = "block"
        content_html.style.zIndex = '99'
        content_pc.style.zIndex = '1'
    } else if(type == 1 && bIsWM == 'windows' || type == 1 && bIsWM == 'macOS'){
        button.style.display = "none"
        pcbutton.style.display = "block"
        content_html.style.zIndex = '1'
        content_pc.style.zIndex = '99'
    } else if(type == 2){
        button.style.display = "none"
        pcbutton.style.display = "none"
        content_html.style.zIndex = '1'
        content_pc.style.zIndex = '1'
        mdbutton.style.display = "block"
        content_pc_md.style.zIndex = '99'
    }



    // 腾讯H5
    function change_pic(){
        var button1 = document.getElementById("button1");
        var button2 = document.getElementById("button2");
        var picts = document.getElementById("picts");
        button1.onclick = function(){
            console.log("button1")
            picts.setAttribute("src","./images/stroller_h5.png");
        }
        button2.onclick = function(){
            console.log("button2")
            picts.setAttribute("src","./images/player_h5.png");
        }
    }
    change_pic();
    // 腾讯pc
    function change_pic_pc(){
        var pcbutton1 = document.getElementById("pcbutton1");
        var pcbutton2 = document.getElementById("pcbutton2");
        var pc_picts = document.getElementById("pc_picts");
        pcbutton1.onclick = function(){
            pc_picts.setAttribute("src","./images/stroller_pc.png");
        }
        pcbutton2.onclick = function(){
            pc_picts.setAttribute("src","./images/player_pc.png");
        }
    }
    change_pic_pc()

    // 魔典
    function change_pic_md(){
        var mdbutton1 = document.getElementById("mdbutton1");
        var mdbutton2 = document.getElementById("mdbutton2");
        var md_picts = document.getElementById("md_picts");
        mdbutton1.onclick = function(){
            md_picts.setAttribute("src","./images/stroller_md.png");
        }
        mdbutton2.onclick = function(){
            md_picts.setAttribute("src","./images/player_md.png");
        }
    }
    change_pic_md()
</script>